=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lTag" target="cloudrun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.85;entryX=0;entryY=0.5;endArrow=open;" edge="1" parent="1" source="lTag" target="secrets"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="741"/><mxPoint x="1110" y="880"/></Array></mxGeometry></mxCell><mxCell id="e8" value="⑧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cloudrun" target="gcs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="lTag" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="348"/></Array></mxGeometry></mxCell><mxCell id="e10" value="⑩" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.3;entryX=0;entryY=0.25;" edge="1" parent="1" source="ddb" target="lNotify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.3;" edge="1" parent="1" source="lNotify" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.25;" edge="1" parent="1" source="sns" target="email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="⑪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=1;strokeColor=#1A73E8;" edge="1" parent="1" source="user" target="cloudrun"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="1070"/><mxPoint x="1500" y="1070"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b style='font-size:14px'&gt;Flow legend&lt;/b&gt;&lt;br&gt;① Load the web UI from S3 static hosting&lt;br&gt;② Sign up / sign in via Cognito Hosted UI &amp;rarr; ID token (JWT)&lt;br&gt;③ REST calls with JWT; API Gateway validates it against the Cognito User Pool, then invokes the API Lambdas&lt;br&gt;④ Browser uploads the file straight to S3 with a presigned PUT URL (duplicate SHA-256 checksums rejected first)&lt;br&gt;⑤ S3 ObjectCreated &amp;rarr; thumbnail Lambda writes a resized, compressed copy to thumbnails/&lt;br&gt;⑥ S3 ObjectCreated &amp;rarr; tagging Lambda (videos: one frame every 10 s)&lt;br&gt;⑦ Tagging Lambda calls Cloud Run over HTTPS with a GCP ID token and a presigned GET URL (AWS &amp;rarr; GCP only, no AWS keys in GCP)&lt;br&gt;⑧ Cloud Run loads the model version named in config.json &amp;rarr; new model with no code change&lt;br&gt;⑨ Species counts, file type, file URL and thumbnail URL saved to DynamoDB&lt;br&gt;⑩ DynamoDB Streams &amp;rarr; notify Lambda &amp;rarr; SNS (filter policy per tag) &amp;rarr; subscriber email&lt;br&gt;⑪ Query by file / lost-pet photo: browser sends image + Cognito JWT to Cloud Run, which verifies it with the Cognito JWKS and runs inference in memory (never stored); the returned tags are then searched via ③&lt;br&gt;Chatbot: chat Lambda &amp;rarr; Lex V2 &amp;rarr; fulfillment by the search Lambda&lt;br&gt;&lt;br&gt;&lt;b&gt;Line styles:&lt;/b&gt; solid = synchronous request &amp;nbsp;&amp;nbsp; dashed = asynchronous event / token validation" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="170" y="1110" width="1570" height="245" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>